+# -*- coding: utf-8 -*-
+import click
+
+
+def test_other_command_invoke(runner):
+    @click.command()
+    @click.pass_context
+    def cli(ctx):
+        return ctx.invoke(other_cmd, 42)
+
+    @click.command()
+    @click.argument('arg', type=click.INT)
+    def other_cmd(arg):
+        click.echo(arg)
+
+    result = runner.invoke(cli, [])
+    assert not result.exception
+    assert result.output == '42\n'
